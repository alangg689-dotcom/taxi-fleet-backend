# Copiar a .env y ajustar. NUNCA subir .env al repositorio.

DEBUG=true

# Coma-separado. En dev, "*" (default) para no fricción con el puerto del
# dashboard local. En producción, el dominio real, ej.:
#   CORS_ORIGINS=https://dashboard.tuflotilla.mx
CORS_ORIGINS=*

DATABASE_URL=postgresql+asyncpg://flotilla:flotilla@localhost:5432/flotilla
REDIS_URL=redis://localhost:6379/0

# Generar con: openssl rand -hex 32
JWT_SECRET=cambiar-por-un-secreto-aleatorio-largo
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30

# OTP
OTP_TTL_SECONDS=300
OTP_MAX_REQUESTS=3
OTP_MAX_ATTEMPTS=5

# Login de operadores/admin (email + password): mismo mecanismo de bloqueo que el OTP
LOGIN_MAX_ATTEMPTS=5
LOGIN_ATTEMPT_WINDOW=900
LOGIN_LOCKOUT_SECONDS=1800

# SMS: "console" imprime el código en la terminal (solo desarrollo).
# Para producción, SMS_PROVIDER=twilio y llenar las tres de abajo:
#   TWILIO_ACCOUNT_SID   -> "Account SID" del dashboard de Twilio (empieza con AC)
#   TWILIO_AUTH_TOKEN    -> "Auth Token" del mismo dashboard
#   TWILIO_FROM_NUMBER   -> número de Twilio en formato E.164, ej. +14155238886
SMS_PROVIDER=console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
