# Copiar a .env y ajustar. NUNCA subir .env al repositorio.

DEBUG=true

# Coma-separado. En dev, "*" (default) para no fricción con el puerto del
# dashboard local. En producción, el dominio real, ej.:
#   CORS_ORIGINS=https://dashboard.tuflotilla.mx
# Con DEBUG=false y esto en "*", el backend lo avisa en el log al arrancar
# (ver _warn_on_insecure_config en app/main.py).
CORS_ORIGINS=*

DATABASE_URL=postgresql+asyncpg://flotilla:flotilla@localhost:5432/flotilla
REDIS_URL=redis://localhost:6379/0

# Generar con: openssl rand -hex 32
JWT_SECRET=cambiar-por-un-secreto-aleatorio-largo
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30

# Login: throttle compartido por /auth/login (operador/admin, email) y
# /auth/driver-login (chofer, teléfono + PIN que asigna el operador).
LOGIN_MAX_ATTEMPTS=5
LOGIN_ATTEMPT_WINDOW=900
LOGIN_LOCKOUT_SECONDS=1800

# Twilio: bot de WhatsApp de clientes (POST /whatsapp/webhook) y entrega de
# la device_key GPS al chofer al crear/regenerar la unidad. El login de
# chofer ya no depende de Twilio. Vacías: warning en el log, la API igual
# devuelve device_key en JSON.
#   TWILIO_ACCOUNT_SID   -> "Account SID" del dashboard de Twilio (empieza con AC)
#   TWILIO_AUTH_TOKEN    -> "Auth Token" del mismo dashboard
#   TWILIO_WHATSAPP_FROM -> remitente, formato "whatsapp:+E164"
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# El default es el sandbox compartido de Twilio; al pasar a un número de
# WhatsApp Business propio, reemplazar por ese número en formato "whatsapp:+E164".
# TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Bot de Telegram: token que da @BotFather. Lo usan las DOS partes — el
# backend para escribirle al cliente (app/core/telegram.py) y el proceso del
# bot para escuchar (bot/telegram_bot.py). Vacío = canal de Telegram apagado.
TELEGRAM_BOT_TOKEN=

# Clave compartida entre el backend y los procesos de bot (header X-Bot-Key en
# POST /bot/request-ride). Ese endpoint crea viajes reales sin sesión de
# operador ni de chofer: abierto, cualquiera podría llenar la flotilla de
# servicios fantasma. Vacía = el endpoint contesta 503, nunca queda abierto.
# Genera una con 'openssl rand -hex 32'.
BOT_API_KEY=

# Radio en metros para dar por llegada la unidad al punto de recogida y avisarle
# al cliente (app/core/arrival.py). 30 m es el orden del error típico de un GPS
# de celular en calle con edificios: más chico nunca avisa, más grande avisa
# desde la esquina anterior.
# TRIP_ARRIVAL_RADIUS_METERS=30.0

# Techo de telemetría por unidad y ventana (app/core/ping_throttle.py). Acota
# el daño si se filtra un device_key, que es una credencial fija que no expira.
# Holgado a propósito: la cadencia normal ronda 20 pings/min, pero al recuperar
# señal la app vacía su buffer de golpe y eso debe entrar sin perderse.
# PING_MAX_PER_WINDOW=600
# PING_WINDOW_SECONDS=60

# Motor de despacho automático (POST /trips/dispatch) — los defaults ya son
# razonables, normalmente no hace falta tocarlos.
# DISPATCH_OFFER_TIMEOUT_SECONDS=25
# DISPATCH_SEARCH_RADIUS_METERS=15000
# DISPATCH_MAX_CANDIDATES=10
# Alineado con QUEUE_SIGNAL_DROP_SECONDS (sitios): si se cambia uno hay que
# mover el otro, o la fila avanza sin razón visible.
# DISPATCH_POSITION_FRESHNESS_SECONDS=420

# Cuánto aguanta un viaje esperando chofer antes de avisarle al cliente que no
# hay taxis. El tope cambia solo según la presión del momento: en operación
# normal rige el primero, y cuando hay muchos viajes en cola con pocos choferes
# libres, el segundo — porque ahí sí va a haber taxi, solo que tarda, y
# rendirse pronto tiraría un viaje que se habría podido servir.
# BOT_TRIP_MAX_WAIT_SECONDS=600
# BOT_TRIP_MAX_WAIT_HIGH_DEMAND_SECONDS=1200

# Qué cuenta como "alta demanda". Las DOS condiciones a la vez: muchos viajes
# esperando Y pocos choferes que puedan tomarlos. Con una sola, cualquier racha
# de un minuto dispararía el modo saturación.
# HIGH_DEMAND_MIN_WAITING_TRIPS=5
# HIGH_DEMAND_MAX_AVAILABLE_DRIVERS=3

# Techo de solicitudes por cliente en POST /bot/request-ride (ventana en
# segundos). Frena scripts que pidan en bucle; el flujo normal nunca lo toca.
# BOT_RIDE_MAX_PER_WINDOW=6
# BOT_RIDE_WINDOW_SECONDS=300

# Autorregistro de choferes: fotos locales (rostro y licencia, sin tarjetón).
# UPLOAD_DIR=uploads
# UPLOAD_MAX_BYTES=5242880
# DRIVER_APP_RATE_LIMIT_MAX=8
# DRIVER_APP_RATE_LIMIT_WINDOW_SECONDS=3600
# DRIVER_UPLOAD_RATE_LIMIT_MAX=20
# DRIVER_UPLOAD_RATE_LIMIT_WINDOW_SECONDS=3600
