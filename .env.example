# Copiar a .env y ajustar. NUNCA subir .env al repositorio.

DEBUG=true

# Coma-separado. En dev, "*" (default) para no fricción con el puerto del
# dashboard local. En producción, el dominio real, ej.:
#   CORS_ORIGINS=https://dashboard.tuflotilla.mx
CORS_ORIGINS=*

DATABASE_URL=postgresql+asyncpg://flotilla:flotilla@localhost:5432/flotilla
REDIS_URL=redis://localhost:6379/0

# Generar con: openssl rand -hex 32
JWT_SECRET=cambiar-por-un-secreto-aleatorio-largo
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30

# Login: throttle compartido por /auth/login (operador/admin, email) y
# /auth/driver-login (chofer, teléfono + PIN que asigna el operador).
LOGIN_MAX_ATTEMPTS=5
LOGIN_ATTEMPT_WINDOW=900
LOGIN_LOCKOUT_SECONDS=1800

# Twilio: solo lo usa el bot de WhatsApp de clientes (POST /whatsapp/webhook)
# — el login de chofer ya no depende de Twilio.
#   TWILIO_ACCOUNT_SID   -> "Account SID" del dashboard de Twilio (empieza con AC)
#   TWILIO_AUTH_TOKEN    -> "Auth Token" del mismo dashboard
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# El default es el sandbox compartido de Twilio; al pasar a un número de
# WhatsApp Business propio, reemplazar por ese número en formato "whatsapp:+E164".
# TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Motor de despacho automático (POST /trips/dispatch) — los defaults ya son
# razonables, normalmente no hace falta tocarlos.
# DISPATCH_OFFER_TIMEOUT_SECONDS=25
# DISPATCH_SEARCH_RADIUS_METERS=5000
# DISPATCH_MAX_CANDIDATES=10
# DISPATCH_POSITION_FRESHNESS_SECONDS=300
